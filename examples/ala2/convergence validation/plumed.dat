RESTART
UNITS LENGTH=A Energy=kcal/mol
phi: TORSION ATOMS=5,7,9,15
 DEEPIBP ...
  LABEL=deepibp
  ARG=phi
  PACE=500
  HEIGHT_SUB=0.2
  SIGMA_SUB=0.2
  GUESS
  GUESS_RFILE=POINT
  STRIDEFES=5
  NGauss=600
  GRID_BIN=200
  GRID_MAX=pi
  GRID_MIN=-pi
  TEMP=300
  FILE=HILLS
 ...
 PRINT ARG=phi FILE=cv.txt STRIDE=1

 
