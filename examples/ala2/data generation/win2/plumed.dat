RESTART
UNITS LENGTH=A Energy=kcal/mol
phi: TORSION ATOMS=5,7,9,15
UPPER_WALLS ARG=phi AT=-1.8 KAPPA=200 EXP=2 EPS=1 OFFSET=0  LABEL=wall2
LOWER_WALLS ARG=phi AT=-2.35 KAPPA=100 EXP=2 EPS=1 OFFSET=0 LABEL=wall1
 DEEPIBP ...
  LABEL=deepibp
  ARG=phi
  PACE=500
  KL_REGION
  MONITOR_CVS=0
  HEIGHT_SUB=0.2
  SIGMA_SUB=0.2
  SUBNN
  DCV=0.4
  CUSTOM_THR=-2.35
  CUSTOM_THR_OP=GE
  MIN_REGION=0.1
  HIT_TRIGGER=12
  ADAPTIVE_K
  KL_THRESHOLD=0.1
  SAMPLES_MIN=500
  N_sub=2
  NGauss=300
  unbSteps=1500
  GRID_BIN=100
  EXP_U=2
  EXP_L=2
  KAPPA_U=200
  KAPPA_L=100
  UPPER_WALL=-1.8
  LOWER_WALL=-2.35
  GRID_MAX=pi
  GRID_MIN=-pi
  TEMP=300
  FILE=HILLS
 ...
PRINT ARG=phi FILE=cv.txt STRIDE=1

 
